---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { getProducts } from '../data/catalog';
import { SITE_URL as siteUrl } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
const products = getProducts(lang);
const filters = ['all', 'finished', 'blades', 'accessories'] as const;
const filterKeys = { all: 'category_all', finished: 'category_finished', blades: 'category_blades', accessories: 'category_accessories' } as const;
---

<Base title={tr.catalog_page_title} description={tr.catalog_subtitle}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.nav_catalog, "item": siteUrl + '/catalog/' }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-14 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label justify-center mb-3" data-i18n="catalog_label">{tr.catalog_label}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5 break-words" data-i18n="catalog_heading">{tr.catalog_heading}</h1>
      <p class="text-frost/80 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed" data-i18n="catalog_subtitle">{tr.catalog_subtitle}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
        <nav id="catalog-filters" class="flex flex-wrap gap-2" aria-label={tr.catalog_label}>
          {filters.map((f) => (
            <button
              type="button"
              data-cat={f}
              data-i18n={filterKeys[f]}
              class={
                f === 'all'
                  ? "filter-btn px-4 py-2 text-xs font-black uppercase tracking-industrial border-2 border-bolt bg-bolt text-thunder"
                  : "filter-btn px-4 py-2 text-xs font-black uppercase tracking-industrial border-2 border-frost-dark text-frost-dark hover:border-bolt hover:text-bolt transition"
              }
            >{tr[filterKeys[f]]}</button>
          ))}
        </nav>
        <p class="text-xs text-frost-dark/60" data-i18n="catalog_search_note">{tr.catalog_search_note}</p>
      </div>

      <div id="catalog-empty" class="hidden text-center py-12 bg-white border-2 border-frost-dark">
        <p class="text-frost-dark/70" data-i18n="catalog_empty">{tr.catalog_empty}</p>
      </div>

      <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {products.map((p, i) => (
          <a
            href={`${import.meta.env.BASE_URL}product/${p.sku}`}
            data-cat={p.category}
            data-search={`${p.sku} ${p.name} ${p.short}`.toLowerCase()}
            class="product-card group block min-w-0"
          >
            <div class="aspect-square bg-thunder overflow-hidden flex items-center justify-center relative">
              <ProductImage sku={p.sku} name={p.name} class="absolute inset-0" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
            </div>
            <div class="p-5">
              <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60 mb-1"><span data-i18n="article">{tr.article}</span> {p.sku}</div>
              <h2 class="font-display font-bold text-thunder leading-snug mb-2 group-hover:text-bolt transition" data-i18n={p.nameKey}>{p.name}</h2>
              <p class="text-frost-dark/70 text-sm mb-4" data-i18n={p.shortKey}>{p.short}</p>
              <div class="flex items-end justify-between gap-3 pt-4 border-t border-frost-dark">
                <span class="font-display font-black text-thunder text-2xl">{p.price.toLocaleString('ru-RU')} {tr.currency_symbol}</span>
                <span class="text-bolt font-black text-xs uppercase tracking-industrial group-hover:translate-x-1 transition">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var nav = document.getElementById('catalog-filters');
      var grid = document.getElementById('catalog-grid');
      var empty = document.getElementById('catalog-empty');
      if (!nav || !grid || !empty) return;

      var cards = Array.from(grid.querySelectorAll('[data-cat]'));
      var buttons = Array.from(nav.querySelectorAll('button[data-cat]'));
      var activeClass = ['border-bolt', 'bg-bolt', 'text-thunder'];
      var inactiveClass = ['border-frost-dark', 'text-frost-dark', 'hover:border-bolt', 'hover:text-bolt', 'transition'];
      var params = new URLSearchParams(window.location.search);
      var query = (params.get('q') || '').trim().toLowerCase();
      var category = params.get('cat') || 'all';
      if (['all', 'finished', 'blades', 'accessories'].indexOf(category) === -1) category = 'all';

      function apply(cat) {
        category = cat;
        var visible = 0;
        cards.forEach(function (card) {
          var byCategory = cat === 'all' || card.dataset.cat === cat;
          var byQuery = !query || (card.dataset.search || '').indexOf(query) !== -1;
          var show = byCategory && byQuery;
          card.style.display = show ? '' : 'none';
          if (show) visible += 1;
        });
        empty.classList.toggle('hidden', visible > 0);
        buttons.forEach(function (button) {
          var isActive = button.dataset.cat === cat;
          button.classList.add.apply(button.classList, isActive ? activeClass : inactiveClass);
          button.classList.remove.apply(button.classList, isActive ? inactiveClass : activeClass);
        });
        try {
          var qs = new URLSearchParams();
          if (cat !== 'all') qs.set('cat', cat);
          if (query) qs.set('q', query);
          var suffix = qs.toString() ? '?' + qs.toString() : '';
          history.replaceState(null, '', window.location.pathname + suffix);
        } catch (e) {}
      }

      nav.addEventListener('click', function (event) {
        var button = event.target.closest('button[data-cat]');
        if (button) apply(button.dataset.cat);
      });
      apply(category);
    })();
  </script>
</Base>
