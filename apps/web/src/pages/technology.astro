---
import Base from '../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { SITE_URL as siteUrl } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
const steps = [
  ['tech_step1_title', 'tech_step1_desc'],
  ['tech_step2_title', 'tech_step2_desc'],
  ['tech_step3_title', 'tech_step3_desc'],
  ['tech_step4_title', 'tech_step4_desc'],
  ['tech_step5_title', 'tech_step5_desc'],
] as const;
---

<Base title={tr.tech_page_title} description={tr.tech_page_subtitle}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.tech_h1 }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-14 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label justify-center mb-3" data-i18n="tech_label">{tr.tech_label}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n="tech_h1">{tr.tech_h1}</h1>
      <p class="text-frost/80 text-base sm:text-lg max-w-2xl mx-auto" data-i18n="tech_page_subtitle">{tr.tech_page_subtitle}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      {steps.map(([titleKey, descKey], index) => (
        <article class="flex gap-5 bg-white border-l-4 border-bolt p-5 sm:p-6">
          <div class="text-3xl font-display font-black text-bolt shrink-0 w-12">{String(index + 1).padStart(2, '0')}</div>
          <div class="min-w-0">
            <h2 class="font-display font-black text-thunder text-xl mb-2" data-i18n={titleKey}>{tr[titleKey]}</h2>
            <p class="text-frost-dark/70 leading-relaxed" data-i18n={descKey}>{tr[descKey]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
