---
import Base from '../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { MAX_URL } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
const steps = [
  ['guide_step1_title', 'guide_step1_desc'],
  ['guide_step2_title', 'guide_step2_desc'],
  ['guide_step3_title', 'guide_step3_desc'],
  ['guide_step4_title', 'guide_step4_desc'],
] as const;
---

<Base title={tr.guide_title} description={tr.guide_subtitle}>
  <section class="relative bg-thunder text-frost overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
      <div class="inline-block bg-bolt text-thunder px-3 py-1 text-[10px] sm:text-xs font-black uppercase tracking-industrial mb-5" data-i18n="guide_label">{tr.guide_label}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n="guide_h1">{tr.guide_h1}</h1>
      <p class="text-base sm:text-lg text-frost/80 leading-relaxed max-w-2xl mx-auto" data-i18n="guide_subtitle">{tr.guide_subtitle}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
        {steps.map(([titleKey, descKey]) => (
          <article class="bg-white border-l-4 border-bolt p-6">
            <h2 class="font-display font-black text-thunder text-xl mb-2" data-i18n={titleKey}>{tr[titleKey]}</h2>
            <p class="text-frost-dark/70 leading-relaxed" data-i18n={descKey}>{tr[descKey]}</p>
          </article>
        ))}
      </div>

      <div class="flex flex-wrap justify-center gap-3 mt-10">
        <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-bolt" data-i18n="guide_cta_catalog">{tr.guide_cta_catalog}</a>
        <a href={MAX_URL} target="_blank" rel="noopener" class="btn-steel" data-i18n="guide_cta_contact">{tr.guide_cta_contact}</a>
      </div>
    </div>
  </section>
</Base>
