---
import Base from '../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { SITE_URL as siteUrl, MAX_URL } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
---

<Base title={tr.contacts_title} description={tr.contacts_note}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.contacts_h1 }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-14 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label justify-center mb-3" data-i18n="contacts_write">{tr.contacts_write}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n="contacts_h1">{tr.contacts_h1}</h1>
      <p class="text-frost/80 max-w-2xl mx-auto" data-i18n="contacts_note">{tr.contacts_note}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="font-display font-black text-thunder text-2xl uppercase mb-6" data-i18n="contacts_office">{tr.contacts_office}</h2>
        <div class="bg-white border-2 border-frost-dark p-6 space-y-4">
          <div>
            <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60" data-i18n="contacts_address">{tr.contacts_address}</div>
            <div class="font-bold text-thunder" data-i18n="contacts_address_value">{tr.contacts_address_value}</div>
          </div>
          <div>
            <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60" data-i18n="contacts_coords">{tr.contacts_coords}</div>
            <div class="font-mono text-thunder" data-i18n="contacts_coords_value">{tr.contacts_coords_value}</div>
          </div>
          <div>
            <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60" data-i18n="contacts_phone">{tr.contacts_phone}</div>
            <a href={`tel:${tr.phone.replace(/[^+\d]/g, '')}`} class="font-bold text-thunder block hover:text-bolt">{tr.phone}</a>
          </div>
          <div>
            <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60" data-i18n="contacts_email">{tr.contacts_email}</div>
            <a href={`mailto:${tr.email}`} class="font-bold text-thunder block hover:text-bolt">{tr.email}</a>
          </div>
          <div>
            <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60" data-i18n="contacts_hours">{tr.contacts_hours}</div>
            <div class="font-bold text-thunder" data-i18n="contacts_hours_value">{tr.contacts_hours_value}</div>
          </div>
        </div>
      </div>

      <div>
        <h2 class="font-display font-black text-thunder text-2xl uppercase mb-6" data-i18n="contacts_details">{tr.contacts_details}</h2>
        <div class="bg-white border-2 border-frost-dark p-6 space-y-3 text-sm">
          <div class="font-bold text-thunder" data-i18n="contacts_company">{tr.contacts_company}</div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_inn">{tr.contacts_inn}:</span> <span class="font-mono">3801165352 / 380101001</span></div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_legal_address">{tr.contacts_legal_address}:</span> 665832, г. Ангарск, 6 мкр-н, д. 15/15а, кв. 29</div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_bank">{tr.contacts_bank}:</span> АО «Т-банк», г. Москва</div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_account">{tr.contacts_account}:</span> <span class="font-mono">40702810010001927660</span></div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_corr_account">{tr.contacts_corr_account}:</span> <span class="font-mono">30101810145250000974</span></div>
          <div><span class="text-frost-dark/60" data-i18n="contacts_bik">{tr.contacts_bik}:</span> <span class="font-mono">044525974</span></div>
        </div>
        <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt mt-6 w-full text-center inline-flex justify-center" data-i18n="contacts_write">
          {tr.contacts_write}
        </a>
      </div>
    </div>
  </section>
</Base>
