---
import Base from '../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { SITE_URL as siteUrl } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
---

<Base title={tr.about_title} description={tr.about_story_1}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.about_h1 }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-14 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label justify-center mb-3">ГРОМ</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n="about_h1">{tr.about_h1}</h1>
      <p class="text-frost/70 font-mono uppercase tracking-industrial text-xs">2018 · Ангарск · Байкал</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <article class="bg-white border-2 border-frost-dark p-6 sm:p-8 space-y-5 text-base sm:text-lg leading-relaxed">
        <h2 class="font-display font-black text-thunder text-2xl uppercase" data-i18n="about_story_title">{tr.about_story_title}</h2>
        <p class="text-frost-dark/80" data-i18n="about_story_1">{tr.about_story_1}</p>
        <p class="text-frost-dark/80" data-i18n="about_story_2">{tr.about_story_2}</p>
        <p class="text-frost-dark/80" data-i18n="about_story_3">{tr.about_story_3}</p>
      </article>

      <div class="grid sm:grid-cols-3 gap-4 text-center">
        <div class="bg-white border-2 border-frost-dark p-6">
          <div class="text-4xl font-display font-black text-bolt">2018</div>
          <div class="text-xs font-mono uppercase tracking-industrial text-frost-dark/60 mt-2" data-i18n="about_stat_year">{tr.about_stat_year}</div>
        </div>
        <div class="bg-white border-2 border-frost-dark p-6">
          <div class="text-4xl font-display font-black text-bolt">Ангарск</div>
          <div class="text-xs font-mono uppercase tracking-industrial text-frost-dark/60 mt-2" data-i18n="about_stat_place">{tr.about_stat_place}</div>
        </div>
        <div class="bg-white border-2 border-frost-dark p-6">
          <div class="text-4xl font-display font-black text-bolt">MAX</div>
          <div class="text-xs font-mono uppercase tracking-industrial text-frost-dark/60 mt-2" data-i18n="about_stat_help">{tr.about_stat_help}</div>
        </div>
      </div>
    </div>
  </section>
</Base>
