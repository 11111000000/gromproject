---
import Base from '../../layouts/Base.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { t, defaultLang, type Lang } from '../../i18n/translations';
import { getProduct, getReviews } from '../../data/catalog';
import { listProductPhotos } from '../../lib/productPhotos';
import { SITE_URL as siteUrl, MAX_URL } from '../../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];

export function getStaticPaths() {
  return [
    { params: { sku: '001' } }, { params: { sku: '002' } },
    { params: { sku: '003' } }, { params: { sku: '004' } },
    { params: { sku: '005' } }, { params: { sku: '006' } },
  ];
}

const sku = Astro.params.sku as string;
const p = getProduct(lang, sku);
if (!p) return Astro.redirect(import.meta.env.BASE_URL + 'catalog');

const reviews = getReviews(lang);
const galleryImages = listProductPhotos(sku).map((file) => `${siteUrl}/photos-v2/${file}`);
---

<Base title={`${p.name} · GROM`} description={`${p.short}. ${tr.desc}`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": p.name,
    "description": p.desc,
    "image": galleryImages.length ? galleryImages : [`${siteUrl}/photos-v2/${p.sku}.jpg`],
    "sku": p.sku,
    "brand": { "@type": "Brand", "name": "ГРОМ" },
    "manufacturer": { "@type": "Organization", "name": "ООО «ГРОМ»" },
    "offers": {
      "@type": "Offer",
      "price": p.price,
      "priceCurrency": "RUB",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "ГРОМ" }
    },
    "additionalProperty": p.specs.map((s) => ({ "@type": "PropertyValue", "name": s.key, "value": s.value }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.nav_catalog, "item": siteUrl + '/catalog/' },
      { "@type": "ListItem", "position": 3, "name": p.name }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-10 sm:py-16 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs font-mono uppercase tracking-industrial text-frost/50 mb-6">
        <a href={`${import.meta.env.BASE_URL}`} class="hover:text-bolt">ГРОМ</a> ·
        <a href={`${import.meta.env.BASE_URL}catalog`} class="hover:text-bolt" data-i18n="nav_catalog">{tr.nav_catalog}</a> ·
        <span class="text-frost" data-i18n={p.nameKey}>{p.name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <ProductGallery sku={p.sku} name={p.name} />

        <div class="min-w-0">
          <div class="text-[10px] font-mono uppercase tracking-industrial text-frost/50 mb-2"><span data-i18n="article">{tr.article}</span> {p.sku}</div>
          <h1 class="font-display font-black leading-[0.95] text-3xl sm:text-5xl mb-4 break-words" data-i18n={p.nameKey}>{p.name}</h1>
          <p class="text-frost/80 mb-6 leading-relaxed" data-i18n={p.shortKey}>{p.short}</p>
          <div class="font-display font-black text-bolt text-4xl mb-7">{p.price.toLocaleString('ru-RU')} {tr.currency_symbol}</div>

          <div class="bg-frost/5 border-l-4 border-bolt p-4 mb-7">
            <div class="text-bolt font-mono uppercase tracking-industrial text-[10px] mb-2" data-i18n="selector_label">{tr.selector_label}</div>
            <p class="text-frost/85 text-sm leading-relaxed" data-i18n={p.audienceKey}>{p.audience}</p>
          </div>

          {p.variants && (
            <div class="space-y-4 mb-8" id="variants" data-hint={tr.product_choose_hint} data-selected={tr.product_selected_prefix}>
              {p.variants.size && (
                <div data-variant-group={tr.spec_length}>
                  <label class="block text-bolt font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-2" data-i18n="spec_length">{tr.spec_length}</label>
                  <div class="flex flex-wrap gap-2">
                    {p.variants.size.map((size) => <button type="button" class="variant-chip" data-value={size}>{size}</button>)}
                  </div>
                </div>
              )}
              {p.variants.binding && (
                <div data-variant-group={tr.spec_compatibility}>
                  <label class="block text-bolt font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-2" data-i18n="spec_compatibility">{tr.spec_compatibility}</label>
                  <div class="flex flex-wrap gap-2">
                    {p.variants.binding.map((binding) => <button type="button" class="variant-chip" data-value={binding}>{binding}</button>)}
                  </div>
                </div>
              )}
              <p id="variant-status" class="text-xs font-mono uppercase tracking-industrial text-frost/50">{tr.product_choose_hint}</p>
            </div>
          )}

          <div class="flex flex-wrap gap-3">
            <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt text-sm sm:text-base" data-order-btn data-i18n="product_order_cta">{tr.product_order_cta}</a>
            <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-ghost text-sm sm:text-base" data-i18n="product_back">{tr.product_back}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 min-w-0">
          <h2 class="font-display font-black text-thunder text-2xl uppercase mb-4" data-i18n="product_desc_heading">{tr.product_desc_heading}</h2>
          <div class="bg-white border-2 border-frost-dark p-6 text-frost-dark/80 leading-relaxed" data-i18n={p.descKey}>
            {p.desc}
          </div>
        </div>

        <div>
          <h2 class="font-display font-black text-thunder text-2xl uppercase mb-4" data-i18n="product_specs_heading">{tr.product_specs_heading}</h2>
          <div class="bg-white border-2 border-frost-dark divide-y divide-frost-dark">
            {p.specs.map((s) => (
              <div class="flex justify-between gap-4 p-3 text-sm">
                <span class="font-bold text-thunder">{s.key}</span>
                <span class="text-frost-dark/70 text-right">{s.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-8 bg-white border-2 border-bolt/50 p-6">
        <h2 class="font-display font-black text-thunder text-2xl mb-4" data-i18n="product_ready_heading">{tr.product_ready_heading}</h2>
        <p class="text-frost-dark/70 mb-5" data-i18n="product_ready_text">{tr.product_ready_text}</p>
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div class="border border-frost-dark p-4" data-i18n="product_delivery">{tr.product_delivery}</div>
          <div class="border border-frost-dark p-4" data-i18n="product_warranty">{tr.product_warranty}</div>
          <div class="border border-frost-dark p-4" data-i18n="product_check">{tr.product_check}</div>
        </div>
      </div>
    </div>
  </section>

  {p.showReviews && (
    <section class="bg-thunder text-frost py-12 sm:py-16 relative overflow-hidden">
      <div class="absolute inset-0 bg-ice-texture opacity-30"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display font-black text-2xl sm:text-4xl mb-8" data-i18n="product_reviews_heading">{tr.product_reviews_heading}</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {reviews.map((review, index) => (
            <figure class="bg-frost/5 border-l-4 border-bolt p-5">
              <blockquote class="text-frost/90 leading-relaxed mb-3 text-sm" data-i18n={`review_${['anton', 'alexey', 'mikhail'][index]}_text`}>«{review.text}»</blockquote>
              <figcaption class="text-xs font-mono uppercase tracking-industrial text-bolt" data-i18n={`review_${['anton', 'alexey', 'mikhail'][index]}_meta`}>{review.meta}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-frost ice-cracks-bg py-16 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-display font-black text-thunder text-2xl sm:text-4xl mb-4" data-i18n="cta_heading">{tr.cta_heading}</h2>
      <p class="text-frost-dark/70 mb-6">{tr.product_ready_text}</p>
      <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt" data-order-btn data-i18n="product_order_cta">{tr.product_order_cta}</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var root = document.getElementById('variants');
      if (!root) return;
      var status = document.getElementById('variant-status');
      var groups = Array.prototype.slice.call(root.querySelectorAll('[data-variant-group]'));

      function state() {
        var missing = [];
        var values = [];
        groups.forEach(function (group) {
          var active = group.querySelector('.variant-chip.is-active');
          if (active) values.push(active.getAttribute('data-value'));
          else missing.push(group);
        });
        return { missing: missing, values: values };
      }

      function update() {
        var s = state();
        if (s.missing.length === 0) {
          status.textContent = root.getAttribute('data-selected') + ' ' + s.values.join(' · ');
          status.classList.remove('text-frost/50');
          status.classList.add('text-bolt');
        } else {
          status.textContent = root.getAttribute('data-hint') + ' ' + s.missing.map(function (group) {
            return group.getAttribute('data-variant-group').toLowerCase();
          }).join(', ');
          status.classList.add('text-frost/50');
          status.classList.remove('text-bolt');
        }
      }

      root.addEventListener('click', function (event) {
        var chip = event.target.closest('.variant-chip');
        if (!chip) return;
        Array.prototype.forEach.call(chip.parentElement.querySelectorAll('.variant-chip'), function (item) {
          item.classList.remove('is-active');
        });
        chip.classList.add('is-active');
        update();
      });

      update();
    })();
  </script>
</Base>
