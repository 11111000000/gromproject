---
import Base from '../../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../../i18n/translations';
import { SITE_URL as siteUrl, MAX_URL } from '../../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];

const directions = [
  { slug: 'baikal', nameKey: 'tour_baikal_name', descKey: 'tour_baikal_desc' },
  { slug: 'sayany', nameKey: 'tour_sayany_name', descKey: 'tour_sayany_desc' },
  { slug: 'datsans', nameKey: 'tour_datsans_name', descKey: 'tour_datsans_desc' },
] as const;
---

<Base title={tr.tours_title} description={tr.tours_subtitle}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.tours_h1, "item": siteUrl + '/tours/' }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-14 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label justify-center mb-3" data-i18n="tours_label">{tr.tours_label}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n="tours_h1">{tr.tours_h1}</h1>
      <p class="text-base sm:text-lg text-frost/80 leading-relaxed max-w-2xl mx-auto" data-i18n="tours_subtitle">{tr.tours_subtitle}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <h2 class="font-display font-black text-thunder text-3xl sm:text-4xl" data-i18n="tours_directions_heading">{tr.tours_directions_heading}</h2>
        <p class="mt-3 text-frost-dark/70 max-w-2xl mx-auto" data-i18n="tours_directions_subtitle">{tr.tours_directions_subtitle}</p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 sm:gap-6">
        {directions.map((direction) => (
          <a href={`${import.meta.env.BASE_URL}tours/${direction.slug}`} class="group bg-white border-2 border-frost-dark p-6 hover:border-bolt transition">
            <div class="text-bolt font-display font-black text-3xl mb-4">→</div>
            <h3 class="font-display font-black text-thunder text-xl mb-2" data-i18n={direction.nameKey}>{tr[direction.nameKey]}</h3>
            <p class="text-frost-dark/70 text-sm leading-relaxed" data-i18n={direction.descKey}>{tr[direction.descKey]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-thunder text-frost py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-3xl sm:text-5xl mb-4" data-i18n="tours_cta_heading">{tr.tours_cta_heading}</h2>
      <p class="text-frost/75 mb-7" data-i18n="tours_cta_text">{tr.tours_cta_text}</p>
      <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt" data-i18n="tours_cta_action">{tr.tours_cta_action}</a>
    </div>
  </section>
</Base>
