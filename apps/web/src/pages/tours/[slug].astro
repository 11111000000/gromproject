---
import Base from '../../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../../i18n/translations';
import { SITE_URL as siteUrl, MAX_URL } from '../../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];

export function getStaticPaths() {
  return [
    { params: { slug: 'baikal' } },
    { params: { slug: 'sayany' } },
    { params: { slug: 'datsans' } },
  ];
}

const directions = {
  baikal: { nameKey: 'tour_baikal_name', descKey: 'tour_baikal_desc' },
  sayany: { nameKey: 'tour_sayany_name', descKey: 'tour_sayany_desc' },
  datsans: { nameKey: 'tour_datsans_name', descKey: 'tour_datsans_desc' },
} as const;

const slug = Astro.params.slug as keyof typeof directions;
const direction = directions[slug];
if (!direction) return Astro.redirect(import.meta.env.BASE_URL + 'tours');
const name = tr[direction.nameKey];
const desc = tr[direction.descKey];
---

<Base title={`${name} · GROM`} description={`${name}. ${tr.tour_detail_note}`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": tr.site_name, "item": siteUrl + '/' },
      { "@type": "ListItem", "position": 2, "name": tr.tours_h1, "item": siteUrl + '/tours/' },
      { "@type": "ListItem", "position": 3, "name": name }
    ]
  })} />

  <section class="relative bg-thunder text-frost py-12 sm:py-20 overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs font-mono uppercase tracking-industrial text-frost/50 mb-6">
        <a href={`${import.meta.env.BASE_URL}`} class="hover:text-bolt">ГРОМ</a> ·
        <a href={`${import.meta.env.BASE_URL}tours`} class="hover:text-bolt" data-i18n="tours_label">{tr.tours_label}</a> ·
        <span class="text-frost" data-i18n={direction.nameKey}>{name}</span>
      </nav>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl mb-5" data-i18n={direction.nameKey}>{name}</h1>
      <p class="text-lg text-frost/80 max-w-2xl" data-i18n={direction.descKey}>{desc}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="bg-white border-2 border-bolt p-6 sm:p-8">
        <h2 class="font-display font-black text-thunder text-2xl mb-4" data-i18n="tours_cta_heading">{tr.tours_cta_heading}</h2>
        <p class="text-frost-dark/75 leading-relaxed mb-6" data-i18n="tour_detail_note">{tr.tour_detail_note}</p>
        <p class="text-frost-dark/75 leading-relaxed mb-7" data-i18n="tours_cta_text">{tr.tours_cta_text}</p>
        <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt" data-i18n="tours_cta_action">{tr.tours_cta_action}</a>
      </article>
    </div>
  </section>
</Base>
