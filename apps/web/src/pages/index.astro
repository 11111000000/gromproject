---
import Base from '../layouts/Base.astro';
import ProductImage from '../components/ProductImage.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { getProducts, getReviews } from '../data/catalog';
import { SITE_URL as siteUrl } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
const products = getProducts(lang);
const reviews = getReviews(lang);

const selectorI18n = Object.fromEntries((Object.keys(t) as Lang[]).map((l) => [
  l,
  {
    empty: t[l].selector_result_empty,
    ready460: t[l].selector_result_ready_460,
    ready520: t[l].selector_result_ready_520,
    blade480: t[l].selector_result_blade_480,
    blade520: t[l].selector_result_blade_520,
    contact: t[l].selector_result_contact,
    cta: t[l].selector_button,
    contactCta: t[l].cta_contact,
  },
]));
---

<Base title={tr.site_name} description={tr.desc}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ГРОМ",
    "alternateName": ["GROM", "ГРОМ коньки", "GROM skates"],
    "url": siteUrl + '/',
    "logo": siteUrl + '/og-image.png',
    "description": tr.desc,
    "foundingDate": "2018",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ангарск",
      "addressRegion": "Иркутская область",
      "addressCountry": "RU"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+7-902-576-19-17",
      "contactType": "sales",
      "areaServed": "RU"
    }
  })} />

  <section class="relative bg-thunder text-frost overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.9fr)] gap-10 lg:gap-14 items-center">
        <div class="min-w-0">
          <div class="inline-flex items-center gap-3 mb-6">
            <div class="w-9 h-9 bg-bolt flex items-center justify-center text-thunder shrink-0">
              <svg width="17" height="17" viewBox="0 0 32 32" class="fill-current"><path d="M19 2 L8 18 L15 18 L11 30 L24 14 L17 14 Z"/></svg>
            </div>
            <span class="text-bolt font-mono uppercase tracking-industrial text-[11px] sm:text-xs" data-i18n="hero_kicker">{tr.hero_kicker}</span>
          </div>

          <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl lg:text-7xl mb-6 max-w-3xl break-words" data-i18n="hero_h1">
            {tr.hero_h1}
          </h1>
          <p class="text-base sm:text-xl text-frost/80 leading-relaxed max-w-2xl mb-8" data-i18n="hero_subtitle">
            {tr.hero_subtitle}
          </p>

          <div class="flex flex-wrap gap-2 mb-8 text-xs sm:text-sm font-mono uppercase tracking-industrial">
            <span class="border border-frost/25 px-3 py-2 bg-frost/5" data-i18n="hero_chip_boots">{tr.hero_chip_boots}</span>
            <span class="border border-frost/25 px-3 py-2 bg-frost/5" data-i18n="hero_chip_steel">{tr.hero_chip_steel}</span>
            <span class="border border-frost/25 px-3 py-2 bg-frost/5" data-i18n="hero_chip_delivery">{tr.hero_chip_delivery}</span>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-bolt text-sm sm:text-base" data-i18n="hero_cta_catalog">{tr.hero_cta_catalog}</a>
            <a href="#size-selector" class="btn-ghost text-sm sm:text-base" data-i18n="hero_cta_size">{tr.hero_cta_size}</a>
          </div>
        </div>

        <a href={`${import.meta.env.BASE_URL}product/001`} class="group block min-w-0 bg-frost/5 border-2 border-frost/25 p-3 sm:p-4 backdrop-blur-sm hover:border-bolt transition">
          <ProductImage sku="001" name={tr.product_001_name} size="hero" loading="eager" fetchpriority="high" class="aspect-[4/3] border border-frost/15" />
          <div class="flex flex-wrap items-end justify-between gap-3 pt-4">
            <div>
              <div class="text-frost/60 text-[10px] font-mono uppercase tracking-industrial mb-1" data-i18n="hero_price_label">{tr.hero_price_label}</div>
              <div class="font-display font-black text-frost text-xl sm:text-2xl" data-i18n="product_001_name">{tr.product_001_name}</div>
            </div>
            <div class="text-bolt font-display font-black text-2xl sm:text-3xl">{products[0].price.toLocaleString('ru-RU')} {tr.currency_symbol}</div>
          </div>
        </a>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 skate-track opacity-40"></div>
  </section>

  <section id="size-selector" class="bg-frost ice-cracks-bg py-16 sm:py-20 border-b-2 border-frost-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <div class="section-label justify-center mb-3" data-i18n="selector_label">{tr.selector_label}</div>
        <h2 class="font-display font-black text-thunder text-3xl sm:text-5xl" data-i18n="selector_heading">{tr.selector_heading}</h2>
        <p class="mt-4 text-frost-dark/70 max-w-2xl mx-auto text-sm sm:text-base" data-i18n="selector_subtitle">{tr.selector_subtitle}</p>
      </div>

      <div class="bg-white border-2 border-frost-dark p-4 sm:p-8">
        <div class="grid sm:grid-cols-3 gap-4 items-end">
          <div>
            <label for="setup-type" class="block text-thunder font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-2" data-i18n="selector_need">{tr.selector_need}</label>
            <select id="setup-type" class="size-input">
              <option value="ready" data-i18n="selector_need_ready">{tr.selector_need_ready}</option>
              <option value="blade" data-i18n="selector_need_blade">{tr.selector_need_blade}</option>
            </select>
          </div>
          <div>
            <label for="boot-size" class="block text-thunder font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-2" data-i18n="selector_size">{tr.selector_size}</label>
            <select id="boot-size" class="size-input">
              <option value="">—</option>
              {Array.from({ length: 13 }, (_, i) => i + 34).map((s) => <option value={s}>{s} EU</option>)}
            </select>
          </div>
          <div>
            <label for="binding-type" class="block text-thunder font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-2" data-i18n="selector_binding">{tr.selector_binding}</label>
            <select id="binding-type" class="size-input">
              <option value="NNN">NNN</option>
              <option value="SNS">SNS</option>
            </select>
          </div>
        </div>

        <div class="mt-6 p-5 bg-thunder text-frost flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="min-w-0">
            <div class="text-frost/60 text-[10px] font-mono uppercase tracking-industrial" data-i18n="selector_note">{tr.selector_note}</div>
            <div id="selector-result" class="text-bolt font-display font-black text-xl sm:text-2xl mt-2 break-words" data-i18n="selector_result_empty">{tr.selector_result_empty}</div>
          </div>
          <a id="selector-cta" href={`${import.meta.env.BASE_URL}contacts`} class="btn-bolt text-sm whitespace-normal text-center sm:whitespace-nowrap pointer-events-none opacity-50" aria-disabled="true" data-i18n="selector_button">{tr.selector_button}</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ selectorI18n, baseUrl: import.meta.env.BASE_URL }}>
    (function () {
      var setup = document.getElementById('setup-type');
      var size = document.getElementById('boot-size');
      var result = document.getElementById('selector-result');
      var cta = document.getElementById('selector-cta');
      if (!setup || !size || !result || !cta) return;

      var lang = new URL(window.location.href).searchParams.get('lang') || localStorage.getItem('grom-lang') || 'ru';
      if (!selectorI18n[lang]) lang = 'ru';
      var d = selectorI18n[lang];

      function setDisabled() {
        result.textContent = d.empty;
        cta.textContent = d.cta;
        cta.removeAttribute('href');
        cta.setAttribute('aria-disabled', 'true');
        cta.classList.add('pointer-events-none', 'opacity-50');
      }

      function update() {
        var n = parseInt(size.value, 10);
        if (!n) return setDisabled();
        cta.removeAttribute('aria-disabled');
        cta.classList.remove('pointer-events-none', 'opacity-50');

        if (setup.value === 'ready') {
          if (n <= 42) {
            result.textContent = d.ready460;
            cta.setAttribute('href', baseUrl + 'product/001');
            return;
          }
          if (n <= 46) {
            result.textContent = d.ready520;
            cta.setAttribute('href', baseUrl + 'product/001');
            return;
          }
        } else {
          if (n >= 38 && n <= 42) {
            result.textContent = d.blade480;
            cta.setAttribute('href', baseUrl + 'product/003');
            return;
          }
          if (n >= 43 && n <= 46) {
            result.textContent = d.blade520;
            cta.setAttribute('href', baseUrl + 'product/003');
            return;
          }
        }

        result.textContent = d.contact;
        cta.textContent = d.contactCta;
        cta.setAttribute('href', baseUrl + 'contacts');
      }

      setup.addEventListener('change', update);
      size.addEventListener('change', update);
      setDisabled();
    })();
  </script>

  <section id="catalog" class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 sm:mb-10 gap-4">
        <div class="min-w-0">
          <div class="section-label mb-3" data-i18n="catalog_label">{tr.catalog_label}</div>
          <h2 class="font-display font-black text-thunder text-3xl sm:text-5xl" data-i18n="catalog_heading">{tr.catalog_heading}</h2>
          <p class="mt-3 text-frost-dark/70 max-w-2xl text-sm sm:text-base" data-i18n="catalog_subtitle">{tr.catalog_subtitle}</p>
        </div>
        <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-steel whitespace-normal sm:whitespace-nowrap" data-i18n="catalog_all">{tr.catalog_all}</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {products.map((p, i) => (
          <a href={`${import.meta.env.BASE_URL}product/${p.sku}`} class="product-card group block min-w-0">
            <div class="aspect-square bg-ice-texture overflow-hidden flex items-center justify-center relative">
              <ProductImage sku={p.sku} name={p.name} class="absolute inset-0" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
            </div>
            <div class="p-5">
              <div class="text-[10px] font-mono uppercase tracking-industrial text-frost-dark/60 mb-1"><span data-i18n="article">{tr.article}</span> {p.sku}</div>
              <h3 class="font-display font-bold text-thunder leading-snug mb-2 group-hover:text-bolt transition text-base" data-i18n={p.nameKey}>{p.name}</h3>
              <p class="text-frost-dark/70 text-sm mb-4" data-i18n={p.shortKey}>{p.short}</p>
              <div class="flex items-end justify-between gap-3 pt-4 border-t border-frost-dark">
                <div class="font-display font-black text-thunder text-xl sm:text-2xl">{p.price.toLocaleString('ru-RU')} <span class="text-sm sm:text-base">{tr.currency_symbol}</span></div>
                <div class="text-bolt font-black text-xs uppercase tracking-industrial group-hover:translate-x-1 transition">→</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-frost py-16 sm:py-20 ice-cracks-bg border-t-2 border-frost-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <div class="section-label justify-center mb-3" data-i18n="tech_label">{tr.tech_label}</div>
        <h2 class="font-display font-black text-thunder text-3xl sm:text-5xl" data-i18n="tech_heading">{tr.tech_heading}</h2>
        <p class="mt-4 text-frost-dark/70 max-w-2xl mx-auto text-sm sm:text-base" data-i18n="tech_subtitle">{tr.tech_subtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {[
          [tr.tech_card1_title, tr.tech_card1_desc, 'tech_card1_title', 'tech_card1_desc'],
          [tr.tech_card2_title, tr.tech_card2_desc, 'tech_card2_title', 'tech_card2_desc'],
          [tr.tech_card3_title, tr.tech_card3_desc, 'tech_card3_title', 'tech_card3_desc'],
          [tr.tech_card4_title, tr.tech_card4_desc, 'tech_card4_title', 'tech_card4_desc'],
        ].map(([title, desc, titleKey, descKey]) => (
          <div class="bg-white border-2 border-frost-dark p-6">
            <div class="font-display font-black text-thunder text-lg leading-tight" data-i18n={titleKey}>{title}</div>
            <div class="text-frost-dark/70 text-sm mt-2 leading-relaxed" data-i18n={descKey}>{desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-thunder text-frost py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-ice-texture opacity-30"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <div class="text-bolt font-mono uppercase tracking-industrial text-[10px] sm:text-xs mb-3" data-i18n="reviews_label">{tr.reviews_label}</div>
        <h2 class="font-display font-black text-3xl sm:text-5xl" data-i18n="reviews_heading">{tr.reviews_heading}</h2>
        <p class="mt-4 text-frost/70 max-w-2xl mx-auto text-sm sm:text-base" data-i18n="reviews_subtitle">{tr.reviews_subtitle}</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 sm:gap-6">
        {reviews.map((r, i) => (
          <figure class="bg-frost/5 border-l-4 border-bolt p-6">
            <blockquote class="text-frost/90 leading-relaxed mb-4" data-i18n={`review_${['anton', 'alexey', 'mikhail'][i]}_text`}>«{r.text}»</blockquote>
            <figcaption class="text-xs font-mono uppercase tracking-industrial text-bolt" data-i18n={`review_${['anton', 'alexey', 'mikhail'][i]}_meta`}>{r.meta}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-thunder text-3xl sm:text-5xl mb-4" data-i18n="cta_heading">{tr.cta_heading}</h2>
      <p class="text-frost-dark/70 max-w-2xl mx-auto mb-7 text-sm sm:text-base" data-i18n="cta_text">{tr.cta_text}</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-bolt" data-i18n="cta_catalog">{tr.cta_catalog}</a>
        <a href={`${import.meta.env.BASE_URL}contacts`} class="btn-steel" data-i18n="cta_contact">{tr.cta_contact}</a>
      </div>
    </div>
  </section>
</Base>
