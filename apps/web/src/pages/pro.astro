---
import Base from '../layouts/Base.astro';
import { t, defaultLang, type Lang } from '../i18n/translations';
import { MAX_URL } from '../lib/site';

const lang = (Astro.url.searchParams.get('lang') as Lang) || defaultLang;
const tr = t[lang];
const principles = [
  ['pro_principle1_title', 'pro_principle1_desc'],
  ['pro_principle2_title', 'pro_principle2_desc'],
  ['pro_principle3_title', 'pro_principle3_desc'],
] as const;
---

<Base title={tr.pro_title} description={tr.pro_subtitle}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": tr.pro_h1,
    "description": tr.pro_subtitle
  })} />

  <section class="relative bg-thunder text-frost overflow-hidden border-b-4 border-bolt">
    <div class="absolute inset-0 bg-ice-texture opacity-80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
      <div class="inline-block bg-bolt text-thunder px-3 py-1 text-[10px] sm:text-xs font-black uppercase tracking-industrial mb-5" data-i18n="pro_label">{tr.pro_label}</div>
      <h1 class="font-display font-black leading-[0.95] text-4xl sm:text-6xl lg:text-7xl mb-5" data-i18n="pro_h1">{tr.pro_h1}</h1>
      <p class="text-base sm:text-xl text-frost/80 leading-relaxed max-w-2xl mx-auto" data-i18n="pro_subtitle">{tr.pro_subtitle}</p>
    </div>
  </section>

  <section class="bg-frost ice-cracks-bg py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="bg-white border-2 border-bolt p-6 sm:p-8 mb-8">
        <h2 class="font-display font-black text-thunder text-2xl sm:text-3xl mb-4" data-i18n="pro_status_heading">{tr.pro_status_heading}</h2>
        <p class="text-frost-dark/75 leading-relaxed" data-i18n="pro_status_text">{tr.pro_status_text}</p>
      </article>

      <h2 class="font-display font-black text-thunder text-2xl sm:text-4xl mb-6 text-center" data-i18n="pro_principles_heading">{tr.pro_principles_heading}</h2>
      <div class="grid sm:grid-cols-3 gap-4 mb-8">
        {principles.map(([titleKey, descKey], index) => (
          <article class="bg-white border-2 border-frost-dark p-5">
            <div class="text-bolt font-display font-black text-3xl mb-3">{String(index + 1).padStart(2, '0')}</div>
            <h3 class="font-display font-black text-thunder text-lg mb-2" data-i18n={titleKey}>{tr[titleKey]}</h3>
            <p class="text-frost-dark/70 text-sm leading-relaxed" data-i18n={descKey}>{tr[descKey]}</p>
          </article>
        ))}
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        <a href={MAX_URL} target="_blank" rel="noopener" class="btn-bolt" data-i18n="pro_cta_notify">{tr.pro_cta_notify}</a>
        <a href={`${import.meta.env.BASE_URL}catalog`} class="btn-steel" data-i18n="pro_cta_catalog">{tr.pro_cta_catalog}</a>
      </div>
    </div>
  </section>
</Base>
