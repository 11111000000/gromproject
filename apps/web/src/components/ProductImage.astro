---
// components/ProductImage.astro
// <picture> с WebP + JPG.
//
// Что важно:
//  1) Заглушка ⚡ лежит ПОД картинкой: картинка её прикрывает, а если картинка
//     не загрузилась — пользователь видит ⚡, а не пустой прямоугольник.
//  2) Если файл не пришёл (обрыв, 404, битый кэш) — onerror прячет сломанный
//     <img> и оставляет заглушку.
//  3) Версия в адресе (?v=) — чтобы браузер не держал старую, битую копию.
interface Props {
  sku: string;
  name: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  size?: 'card' | 'hero';
}
const { sku, name, class: className = '', loading = 'lazy', fetchpriority = 'auto', size = 'card' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconSize = size === 'hero' ? '7xl' : '5xl';
const dim = size === 'hero' ? { w: 1200, h: 675 } : { w: 600, h: 338 };
const dir = 'photos-v2';
// Версия картинок: меняется, чтобы браузер не держал старые (битые) копии.
const v = '3';
const jpg = `${base}/${dir}/${sku}.jpg?v=${v}`;
const webp = `${base}/${dir}/${sku}.webp?v=${v}`;
---
<div class={`product-image-wrap overflow-hidden ${className}`}>
  <picture class="block w-full h-full relative">
    <source srcset={webp} type="image/webp" />
    <img
      src={jpg}
      alt={name}
      class="w-full h-full object-cover block"
      width={dim.w}
      height={dim.h}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      onerror="this.closest('.product-image-wrap')?.classList.add('img-failed');"
    />
  </picture>
  <div class="product-image-fallback absolute inset-0 flex items-center justify-center bg-frost-dark/30 pointer-events-none">
    <span class={`text-bolt text-${iconSize}`}>⚡</span>
  </div>
</div>

<style>
  /* Заглушка — под картинкой (z-0), картинка — над ней (z-1).
     Если картинки нет, остаётся видимый ⚡, а не пустое место. */
  .product-image-fallback { z-index: 0; }
  .product-image-wrap picture { z-index: 1; }
  /* Файл не пришёл — прячем сломанный <img>, чтобы не было «битой» картинки. */
  .product-image-wrap.img-failed img { display: none; }
</style>
