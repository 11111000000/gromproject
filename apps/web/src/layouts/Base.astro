---
import '../styles/global.css';
import { t, langs, type Lang } from '../i18n/translations';
import { SITE_URL as siteUrl } from '../lib/site';
import { THEMES, DEFAULT_THEME, themeGroups } from '../lib/themes.mjs';
import { buildThemeCss } from '../lib/themeCss.mjs';

const { title = 'ГРОМ — озёрные коньки для открытого льда', description } = Astro.props;
const lang = (Astro.url.searchParams.get('lang') as Lang) || 'ru';
const tr = t[lang];
const l = langs[lang];
const slug = Astro.url.pathname;

const themeCss = buildThemeCss();
const themeGroupsList = themeGroups();
const themeKeys = THEMES.map((theme) => theme.key);
const themeMeta = Object.fromEntries(THEMES.map((theme) => [theme.key, theme.meta]));
const defaultTheme = DEFAULT_THEME;
const defaultThemeMeta = themeMeta[defaultTheme];

const metricaId = process.env.METRICA_ID?.trim() || '';
const canonicalURL = `${siteUrl}${slug}`;
const pageDescription = description || tr.desc;
---
<!doctype html>
<html lang={l.htmlLang} dir={l.dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ru" href={`${siteUrl}${slug}?lang=ru`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${slug}?lang=en`} />
    <link rel="alternate" hreflang="zh" href={`${siteUrl}${slug}?lang=zh`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${slug}?lang=ru`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ГРОМ — озёрные коньки" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ГРОМ — озёрные коньки из Ангарска" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />

    {metricaId && (
      <>
        <script is:inline define:vars={{ metricaId }}>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
          ym(metricaId, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
        </script>
        <noscript><div><img src={`https://mc.yandex.ru/watch/${metricaId}`} style="position:absolute;left:-9999px;" alt="" /></div></noscript>
      </>
    )}

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content={defaultThemeMeta} />
    <meta name="x-base-url" content={import.meta.env.BASE_URL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:inline set:html={themeCss}></style>
    <style is:inline>
      html, body { margin: 0; padding: 0; }
      body { background: var(--bg) !important; color: var(--text) !important; }
      #menu-toggle[aria-expanded="true"] .menu-bar:nth-child(1) { transform: translateY(4px) rotate(45deg); }
      #menu-toggle[aria-expanded="true"] .menu-bar:nth-child(2) { opacity: 0; transform: scaleX(0); }
      #menu-toggle[aria-expanded="true"] .menu-bar:nth-child(3) { transform: translateY(-4px) rotate(-45deg); }
      #mobile-menu { will-change: transform, opacity; }
      #mobile-menu.translate-y-0 { transform: translateY(0); }
      #mobile-menu.-translate-y-full { transform: translateY(-100%); }
    </style>
    <script is:inline define:vars={{ themeKeys, themeMeta, defaultTheme }}>
      (function() {
        var KEYS = themeKeys;
        var META = themeMeta;
        var DEFAULT = defaultTheme;
        window.GROM_THEMES = KEYS;
        window.GROM_APPLY_THEME = function (theme, persist) {
          if (KEYS.indexOf(theme) === -1) theme = DEFAULT;
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && META[theme]) meta.setAttribute('content', META[theme]);
          document.querySelectorAll('#theme-switcher [data-theme]').forEach(function (row) {
            var active = row.dataset.theme === theme;
            row.classList.toggle('active', active);
            row.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          var current = document.querySelector('#theme-switcher .theme-current');
          var activeRow = document.querySelector('#theme-switcher [data-theme="' + theme + '"]');
          if (current && activeRow) {
            var name = current.querySelector('.theme-current-name');
            var swatch = current.querySelector('.theme-swatch');
            if (name) name.textContent = activeRow.dataset.label || '';
            if (swatch) {
              swatch.style.setProperty('--sw-bg', activeRow.dataset.swatchBg || '');
              swatch.style.setProperty('--sw-accent', activeRow.dataset.swatchAccent || '');
            }
          }
          if (persist) {
            try { localStorage.setItem('grom-theme', theme); } catch (e) {}
          }
          return theme;
        };
        var saved = null;
        try { saved = localStorage.getItem('grom-theme'); } catch (e) {}
        window.GROM_APPLY_THEME(saved || DEFAULT, false);
      })();
    </script>
    <script is:inline>
      (function() {
        var url = new URL(window.location.href);
        var lang = url.searchParams.get('lang') || localStorage.getItem('grom-lang') || 'ru';
        if (!['ru', 'en', 'zh'].includes(lang)) lang = 'ru';
        localStorage.setItem('grom-lang', lang);
        document.documentElement.setAttribute('data-lang', lang);

        var langBtns = document.querySelectorAll('[data-lang-link]');
        langBtns.forEach(function(btn) {
          btn.classList.toggle('active', btn.getAttribute('data-lang-link') === lang);
        });

        var baseUrl = (document.querySelector('meta[name="x-base-url"]') || {}).content || '/';
        fetch(baseUrl + 'i18n.json').then(function(r) { return r.json(); }).then(function(dict) {
          if (!dict[lang] || lang === 'ru') return;
          var d = dict[lang];
          var ru = dict.ru;

          var textMap = {};
          Object.keys(ru).forEach(function(key) {
            if (typeof ru[key] === 'string' && ru[key].length > 1 && d[key] && d[key] !== ru[key]) {
              textMap[ru[key]] = d[key];
            }
          });

          var pageTitle = document.title.trim();
          Object.keys(ru).forEach(function(key) {
            if (ru[key] === pageTitle && d[key]) document.title = d[key];
            if (key.indexOf('product_') === 0 && key.slice(-5) === '_name' && pageTitle.indexOf(ru[key] + ' · ') === 0) {
              document.title = d[key] + pageTitle.slice(ru[key].length);
            }
          });
          var metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc && textMap[metaDesc.getAttribute('content')]) {
            metaDesc.setAttribute('content', textMap[metaDesc.getAttribute('content')]);
          }

          document.querySelectorAll('[data-i18n]').forEach(function(el) {
            var key = el.getAttribute('data-i18n');
            if (!d[key]) return;
            var original = el.textContent.trim();
            var quoted = original.charAt(0) === '«' && original.charAt(original.length - 1) === '»';
            el.textContent = quoted ? '«' + d[key] + '»' : d[key];
          });
          document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
            var key = el.getAttribute('data-i18n-placeholder');
            if (d[key]) el.setAttribute('placeholder', d[key]);
          });

          function replaceTextNodes(root) {
            if (!root) return;
            if (root.nodeType === 3) {
              var text = root.textContent.trim();
              if (textMap[text]) root.textContent = textMap[text];
              return;
            }
            if (root.nodeType !== 1 || ['SCRIPT', 'STYLE', 'CODE', 'PRE'].indexOf(root.tagName) !== -1) return;
            Array.prototype.forEach.call(root.childNodes, replaceTextNodes);
          }
          replaceTextNodes(document.body);
        }).catch(function() {});
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-bolt focus:text-thunder focus:px-4 focus:py-2 focus:font-black focus:uppercase focus:tracking-industrial focus:text-sm">
      {lang === 'ru' ? 'Перейти к содержимому' : lang === 'en' ? 'Skip to main content' : '跳到主要内容'}
    </a>

    <header class="bg-thunder/95 text-frost sticky top-0 z-50 border-b-2 border-bolt/40 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-2">
        <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2 sm:gap-3 group shrink-0 min-w-0">
          <svg width="24" height="24" viewBox="0 0 32 32" class="hidden sm:block text-bolt fill-current group-hover:scale-110 transition-transform">
            <path d="M19 2 L8 18 L15 18 L11 30 L24 14 L17 14 Z"/>
          </svg>
          <div class="leading-none min-w-0">
            <span class="text-base sm:text-lg font-black tracking-tight">ГРОМ</span>
            <span class="hidden sm:block text-[10px] text-frost/50 uppercase tracking-industrial mt-0.5" data-i18n="site_tagline">{tr.site_tagline}</span>
          </div>
        </a>

        <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 text-frost shrink-0" aria-label={lang === 'ru' ? 'Открыть меню' : lang === 'en' ? 'Open menu' : '打开菜单'} aria-expanded="false" aria-controls="mobile-menu">
          <span class="menu-bar block w-5 h-0.5 bg-current transition-all duration-300 origin-center"></span>
          <span class="menu-bar block w-5 h-0.5 bg-current transition-all duration-300"></span>
          <span class="menu-bar block w-5 h-0.5 bg-current transition-all duration-300 origin-center"></span>
        </button>

        <nav class="hidden md:flex items-center gap-1 text-xs font-bold uppercase tracking-industrial">
          <a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}`} class="px-2 py-2 hover:text-bolt transition" data-i18n="nav_catalog">{tr.nav_catalog}</a>
          <a href={`${import.meta.env.BASE_URL}technology?lang=${lang}`} class="px-2 py-2 hover:text-bolt transition" data-i18n="nav_technology">{tr.nav_technology}</a>
          <a href={`${import.meta.env.BASE_URL}about?lang=${lang}`} class="px-2 py-2 hover:text-bolt transition" data-i18n="nav_brand">{tr.nav_brand}</a>
          <a href={`${import.meta.env.BASE_URL}contacts?lang=${lang}`} class="px-2 py-2 hover:text-bolt transition" data-i18n="nav_contacts">{tr.nav_contacts}</a>
        </nav>

        <div class="hidden sm:flex items-center gap-2 lg:gap-3">
          <input
            type="search"
            id="site-search"
            placeholder={tr.search_placeholder}
            data-i18n-placeholder="search_placeholder"
            class="hidden lg:block bg-frost/10 border border-frost/30 text-frost text-xs font-mono px-3 py-1.5 w-40 focus:w-48 transition-all focus:outline-none focus:border-bolt placeholder:text-frost/40"
            onkeydown={`if(event.key==='Enter'){var q=document.getElementById('site-search').value;if(q)window.location.href='${import.meta.env.BASE_URL}catalog/?q='+encodeURIComponent(q)}`}
          />
          <div class="theme-switcher flex-shrink-0" id="lang-switcher" aria-label={tr.language_label}>
            <a href={`${slug}?lang=ru`} class="theme-btn" data-lang-link="ru" aria-label="Русский язык">RU</a>
            <a href={`${slug}?lang=en`} class="theme-btn" data-lang-link="en" aria-label="English">EN</a>
            <a href={`${slug}?lang=zh`} class="theme-btn" data-lang-link="zh" aria-label="中文">ZH</a>
          </div>
          <div class="theme-switcher flex-shrink-0 relative" id="theme-switcher">
            <button type="button" class="theme-current" id="theme-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="theme-panel" aria-label="Тема оформления">
              <span class="theme-swatch" aria-hidden="true"></span>
              <span class="theme-current-name">Байкал</span>
              <span class="theme-caret" aria-hidden="true">▾</span>
            </button>
            <div class="theme-panel" id="theme-panel" role="menu" aria-label="Темы оформления">
              {themeGroupsList.map((group) => (
                <div>
                  <div class="theme-panel-title">{group.label}</div>
                  {group.themes.map((theme) => (
                    <button
                      type="button"
                      class="theme-row"
                      data-theme={theme.key}
                      data-label={theme.label}
                      data-swatch-bg={theme.swatch[0]}
                      data-swatch-accent={theme.swatch[1]}
                      role="menuitemradio"
                      aria-pressed="false"
                    >
                      <span class="theme-swatch" style={`--sw-bg:${theme.swatch[0]};--sw-accent:${theme.swatch[1]}`} aria-hidden="true"></span>
                      <span>{theme.label}</span>
                      <span class="theme-row-note">{theme.note}</span>
                    </button>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <a href={`tel:${tr.phone.replace(/[^+\d]/g, '')}`} class="hidden lg:flex items-center text-xs font-mono text-frost/80 hover:text-bolt transition shrink-0">
            {tr.phone}
          </a>
        </div>
      </div>
    </header>

    <div id="mobile-menu" class="md:hidden fixed inset-x-0 top-14 sm:top-16 z-40 bg-thunder/98 border-b-2 border-bolt/40 backdrop-blur-md transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-in-out max-h-[80vh] overflow-y-auto" aria-hidden="true">
      <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1 text-sm font-bold uppercase tracking-industrial">
        <a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}`} class="mobile-nav-link px-3 py-3 hover:text-bolt hover:bg-frost/5 transition rounded" data-i18n="nav_catalog">{tr.nav_catalog}</a>
        <a href={`${import.meta.env.BASE_URL}technology?lang=${lang}`} class="mobile-nav-link px-3 py-3 hover:text-bolt hover:bg-frost/5 transition rounded" data-i18n="nav_technology">{tr.nav_technology}</a>
        <a href={`${import.meta.env.BASE_URL}about?lang=${lang}`} class="mobile-nav-link px-3 py-3 hover:text-bolt hover:bg-frost/5 transition rounded" data-i18n="nav_brand">{tr.nav_brand}</a>
        <a href={`${import.meta.env.BASE_URL}contacts?lang=${lang}`} class="mobile-nav-link px-3 py-3 hover:text-bolt hover:bg-frost/5 transition rounded" data-i18n="nav_contacts">{tr.nav_contacts}</a>
        <div class="border-t border-frost/10 my-2"></div>
        <div class="px-3 py-2">
          <input
            type="search"
            id="site-search-mobile"
            placeholder={tr.search_placeholder}
            data-i18n-placeholder="search_placeholder"
            class="bg-frost/10 border border-frost/30 text-frost text-xs font-mono px-3 py-2 w-full focus:outline-none focus:border-bolt placeholder:text-frost/40"
            onkeydown={`if(event.key==='Enter'){var q=document.getElementById('site-search-mobile').value;if(q)window.location.href='${import.meta.env.BASE_URL}catalog/?q='+encodeURIComponent(q)}`}
          />
        </div>
        <div class="px-3 py-2 flex items-center gap-2">
          <span class="text-[10px] font-mono uppercase tracking-industrial text-frost/50" data-i18n="language_label">{tr.language_label}</span>
          <a href={`${slug}?lang=ru`} class="theme-btn px-2 py-1" data-lang-link="ru">RU</a>
          <a href={`${slug}?lang=en`} class="theme-btn px-2 py-1" data-lang-link="en">EN</a>
          <a href={`${slug}?lang=zh`} class="theme-btn px-2 py-1" data-lang-link="zh">ZH</a>
        </div>
        <div class="px-3 py-2">
          <a href={`tel:${tr.phone.replace(/[^+\d]/g, '')}`} class="text-xs font-mono text-frost/80 hover:text-bolt transition">{tr.phone}</a>
        </div>
      </nav>
    </div>

    <main id="main-content" class="flex-1 overflow-x-hidden">
      <slot />
    </main>

    <footer class="bg-steel text-frost/80 overflow-x-hidden">
      <div class="skate-track"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 mb-4">
              <svg width="24" height="24" viewBox="0 0 32 32" class="text-bolt fill-current"><path d="M19 2 L8 18 L15 18 L11 30 L24 14 L17 14 Z"/></svg>
              <span class="font-black text-lg text-frost">ГРОМ</span>
            </div>
            <p class="text-sm leading-relaxed" data-i18n="desc">{tr.desc}</p>
          </div>
          <div>
            <h2 class="text-frost font-black uppercase text-[11px] tracking-industrial mb-3" data-i18n="footer_catalog">{tr.footer_catalog}</h2>
            <ul class="space-y-1.5 text-sm">
              <li><a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}`} class="hover:text-bolt transition" data-i18n="footer_all">{tr.footer_all}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}&cat=blades`} class="hover:text-bolt transition" data-i18n="footer_blades">{tr.footer_blades}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}&cat=finished`} class="hover:text-bolt transition" data-i18n="footer_finished">{tr.footer_finished}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}catalog?lang=${lang}&cat=accessories`} class="hover:text-bolt transition" data-i18n="footer_accessories">{tr.footer_accessories}</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-frost font-black uppercase text-[11px] tracking-industrial mb-3" data-i18n="footer_info">{tr.footer_info}</h2>
            <ul class="space-y-1.5 text-sm">
              <li><a href={`${import.meta.env.BASE_URL}technology?lang=${lang}`} class="hover:text-bolt transition" data-i18n="footer_technology">{tr.footer_technology}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}about?lang=${lang}`} class="hover:text-bolt transition" data-i18n="footer_brand">{tr.footer_brand}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}pro?lang=${lang}`} class="hover:text-bolt transition" data-i18n="footer_pro">{tr.footer_pro}</a></li>
              <li><a href={`${import.meta.env.BASE_URL}sravnenie?lang=${lang}`} class="hover:text-bolt transition" data-i18n="guide_h1">{tr.guide_h1}</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-frost font-black uppercase text-[11px] tracking-industrial mb-3" data-i18n="footer_contacts">{tr.footer_contacts}</h2>
            <ul class="space-y-1.5 text-sm font-mono">
              <li><a href={`tel:${tr.phone.replace(/[^+\d]/g, '')}`} class="hover:text-bolt transition">{tr.phone}</a></li>
              <li><a href={`mailto:${tr.email}`} class="hover:text-bolt transition">{tr.email}</a></li>
              <li data-i18n="address">{tr.address}</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-frost/10">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row gap-2 sm:justify-between text-xs text-frost/40 font-mono">
          <span data-i18n="footer_copyright">{tr.footer_copyright}</span>
          <span data-i18n="footer_made_in">{tr.footer_made_in}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function() {
        var themeSwitcher = document.getElementById('theme-switcher');
        var themeToggle = document.getElementById('theme-toggle');
        var themePanel = document.getElementById('theme-panel');
        if (themeSwitcher && themeToggle && themePanel && window.GROM_APPLY_THEME) {
          function closeThemePanel() {
            themePanel.classList.remove('is-open');
            themeToggle.setAttribute('aria-expanded', 'false');
          }
          themeToggle.addEventListener('click', function(event) {
            event.stopPropagation();
            var open = themePanel.classList.toggle('is-open');
            themeToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          themeSwitcher.addEventListener('click', function(event) {
            var row = event.target && event.target.closest ? event.target.closest('[data-theme]') : null;
            if (!row) return;
            window.GROM_APPLY_THEME(row.dataset.theme, true);
            closeThemePanel();
          });
          document.addEventListener('click', function(event) {
            if (!themeSwitcher.contains(event.target)) closeThemePanel();
          });
          document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') closeThemePanel();
          });
          var savedTheme = null;
          try { savedTheme = localStorage.getItem('grom-theme'); } catch (err) {}
          window.GROM_APPLY_THEME(savedTheme || window.GROM_THEMES[0], false);
        }

        var menuToggle = document.getElementById('menu-toggle');
        var mobileMenu = document.getElementById('mobile-menu');
        if (menuToggle && mobileMenu) {
          function closeMenu() {
            mobileMenu.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
            mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
            mobileMenu.setAttribute('aria-hidden', 'true');
            menuToggle.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('overflow-hidden');
          }
          function openMenu() {
            mobileMenu.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
            mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
            mobileMenu.setAttribute('aria-hidden', 'false');
            menuToggle.setAttribute('aria-expanded', 'true');
            document.body.classList.add('overflow-hidden');
          }
          menuToggle.addEventListener('click', function() {
            var isOpen = mobileMenu.getAttribute('aria-hidden') === 'false';
            if (isOpen) closeMenu(); else openMenu();
          });
          mobileMenu.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', closeMenu);
          });
          document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') closeMenu();
          });
          window.addEventListener('resize', function() {
            if (window.innerWidth >= 768) closeMenu();
          });
        }
      })();
    </script>

    <script is:inline>
      (function() {
        function markBroken() {
          document.querySelectorAll('.product-image-wrap').forEach(function(wrap) {
            var img = wrap.querySelector('img');
            if (!img) return;
            if (img.complete && img.naturalWidth === 0) wrap.classList.add('img-failed');
          });
        }
        if (document.readyState === 'complete') markBroken();
        else window.addEventListener('load', markBroken);
      })();
    </script>
  </body>
</html>
